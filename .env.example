# Nivaran — Environment Variables
# Copy this file to .env and fill in the values

# ── Required ──────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-string

# ── AI Classification (choose one or both) ────────────────────────

# OPTION A: Google Gemini (RECOMMENDED — free, 1500 req/day)
# Get a free key in 1 minute at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OPTION B: OpenRouter (free tier, but rate-limited)
# Get a key at: https://openrouter.ai
OPENROUTER_API_KEY=

# ── Translation ───────────────────────────────────────────────────
# Translation uses Google Translate via deep-translator — FREE, no key needed!
# Nothing to configure here.

# ── AWS DynamoDB (optional — uses local storage by default) ───────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# DYNAMODB_TABLE=nivaran-grievances
